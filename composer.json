{
    "name": "maarheeze/codegraph-laravel",
    "description": "Laravel-specific extractors for CodeGraph code indexing",
    "type": "library",
    "license": "MIT",
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "autoload": {
        "psr-4": {
            "Maarheeze\\CodeGraph\\Laravel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Maarheeze\\CodeGraph\\Laravel\\LaravelServiceProvider"
            ]
        }
    },
    "require": {
        "php": "^8.3",
        "illuminate/console": "^13.0",
        "illuminate/support": "^13.0",
        "maarheeze/codegraph": "^1.1",
        "nikic/php-parser": "^5.7"
    },
    "require-dev": {
        "maarheeze/phpcs": "^1.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
